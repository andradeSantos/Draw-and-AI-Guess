# Banco de Dados PostgreSQL (Local)
POSTGRES_USER=museu_user
POSTGRES_PASSWORD=museu_pass_local
POSTGRES_DB=draw_ia_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://museu_user:museu_pass_local@localhost:5432/draw_ia_db

# Modelo PyTorch e Limiares de Incerteza ("Não sei")
MODEL_ARTIFACTS_DIR=ml/artifacts
UNKNOWN_CONFIDENCE_THRESHOLD=0.75
